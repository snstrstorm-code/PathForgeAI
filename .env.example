# Copy this file to .env (or just export these in your shell) before running the server.
# Get a FREE key (no credit card) from https://console.groq.com/keys — never commit a real key to git.

GROQ_API_KEY=gsk_your-key-here

# Optional — defaults to openai/gpt-oss-120b if not set.
# Other free options: openai/gpt-oss-20b, qwen/qwen3.6-27b
# PATHFORGE_MODEL=openai/gpt-oss-120b
